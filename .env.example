[TEMPLATE]
# Supabase — create a free project at https://supabase.com and paste values here
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public URL of the deployed site (used for share-card and canonical links).
# Local dev default: http://localhost:3000 — set to your https://your-app.vercel.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: required only if you enable Supabase Admin API features (not needed for v1)
# SUPABASE_SERVICE_ROLE_KEY=
